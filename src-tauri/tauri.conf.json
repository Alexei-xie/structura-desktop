{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Structura",
  "version": "0.1.0",
  "identifier": "cn.structura.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "node_modules/.bin/vite --host 0.0.0.0",
    "beforeBuildCommand": "node_modules/.bin/tsc -b && node_modules/.bin/vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Structura",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
